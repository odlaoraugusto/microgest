## Dockerfile de PRODUÇÃO do frontend.
## Para desenvolvimento, use o Dockerfile padrão (vite dev server) via docker-compose.yml.

# --- Etapa 1: build dos arquivos estáticos ---
FROM node:20-alpine AS build

# O Vite "queima" variáveis VITE_* no bundle no momento do build - por
# isso isso precisa ser um build ARG, e não uma env var de runtime.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build

# --- Etapa 2: servir os arquivos estáticos via Nginx ---
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]
